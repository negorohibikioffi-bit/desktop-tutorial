# --- 任意: アプリ名（仮称）。変更するだけで全画面に反映 ---
NEXT_PUBLIC_APP_NAME=Lexa

# --- クラウド同期（Supabase）。未設定ならゲスト（ローカル保存）モードで動作 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI（サーバー側のみ。NEXT_PUBLIC_ を付けないこと！）---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# 1日あたりのAI呼び出し上限（インスタンス単位）。コスト暴走防止
AI_DAILY_LIMIT=300
